{
  "manifest_version": 3,
  "name": "Convergence Bookmark",
  "version": "1.0",
  "description": "Extract bookmarks from your platforms and ingest them",
  "icons": {
    "16": "icons/convergenceimage.png",
    "48": "icons/convergenceimage.png",
    "128": "icons/convergenceimage.png"
  },
  "background": {
    "service_worker": "background.js"
  },
    "permissions": [
        "topSites",
        "webRequest",
        "bookmarks",
        "storage",
        "alarms",
        "tabs",
        "management"
    ],
    "actions": {
        "default_popup": "popup.html",
        "default_title": "Convergence Bookmark"
    }

}