{
    "manifest_version" : 3,
    "name" : "convergence bookmark extension",
    "version" : "1.0",
    "description" : "A Chrome extension to manage bookmarks for the Convergence project.",
    "permissions" : [
    "bookmarks",
    "storage",
    "tabs",
    "webRequest",
    "alarms",
    "cookies",
    "scripting"
    ],
    "host_permissions": [
        "https://x.com/*",
        "https://www.youtube.com/*",
        "https://accounts.google.com/*",
        "http://localhost:8080/*"
    ],
    "oauth2": {
        "client_id":"631666548168-706nhn4jp1r3pcr531ueasrn1omk9oab.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/userinfo.profile",
            "https://www.googleapis.com/auth/userinfo.email"
        ]
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icons/convergenceimage.png",
        "default_title": "Sync Bookmarks"
    },
    "background" : {
        "service_worker" : "background.js"
    },
    "icons": {
        "16": "icons/convergenceimage.png",
        "48": "icons/convergenceimage.png",
        "128": "icons/convergenceimage.png"
    }

}